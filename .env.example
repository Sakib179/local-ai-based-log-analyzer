# Optional: copy to .env and launch with uv run --env-file .env ...
# Relative paths are resolved against the project root, not the shell's cwd.
DATA_DIR=data
# Optional override; defaults to DATA_DIR/analyzer.sqlite3.
# DATABASE_PATH=data/analyzer.sqlite3
LOG_LEVEL=INFO

# Only HTTP loopback URLs are accepted. localhost is normalized to 127.0.0.1.
MODEL_BASE_URL=http://127.0.0.1:8080
MODEL_ALIAS=qwen-local
MODEL_HEALTH_TIMEOUT_SECONDS=3
# Must be between 1 and 2048; this does not configure llama.cpp itself.
MODEL_CONTEXT_TOKENS=2048

# File bytes, excluding bounded multipart headers (10 MiB by default).
MAX_UPLOAD_BYTES=10485760
# Token counting has its own deadline, separate from local generation below.
TOKENIZER_TIMEOUT_SECONDS=30

# Sequential local inference only. 384 output tokens and 64 safety tokens are fixed.
INFERENCE_TIMEOUT_SECONDS=120
INFERENCE_MAX_ATTEMPTS=3
INFERENCE_RETRY_BACKOFF_SECONDS=0.25
# auto: try JSON schema, then simpler JSON output if the server rejects the format.
# Alternatives: json_object, none (strict validation still applies).
INFERENCE_RESPONSE_FORMAT=auto

# Persistent event correlation. Thresholds count distinct original records.
AUTH_FAILURE_THRESHOLD=5
AUTH_WINDOW_SECONDS=1800
# Cautious line-order fallback when comparable timestamps are unavailable.
CORRELATION_LINE_WINDOW=10000
SQL_REPEAT_THRESHOLD=2
SQL_WINDOW_SECONDS=600
SCAN_PATH_THRESHOLD=5
SCAN_WINDOW_SECONDS=300
UNAUTHORIZED_THRESHOLD=5
UNAUTHORIZED_WINDOW_SECONDS=300
REQUEST_RATE_THRESHOLD=100
REQUEST_RATE_WINDOW_SECONDS=60
